{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run one material case",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Generate all results and report",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "cwd": "${workspaceFolder}",
      "args": ["--all", "--report"],
      "console": "integratedTerminal"
    }
  ]
}
